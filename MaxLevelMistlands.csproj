<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>MaxLevelMistlands</AssemblyName>
    <RootNamespace>MaxLevelMistlands</RootNamespace>
    <Version>1.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Product>MaxLevelMistlands</Product>
    <Description>Raises the Galdr Table and Black Forge crafting station level by 2 so gear can be maxed.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Override for another machine: dotnet build -c Release -p:ValheimDir=C:\Steam\steamapps\common\Valheim -->
    <ValheimDir Condition=" '$(ValheimDir)' == '' ">S:\SteamLibrary\steamapps\common\Valheim</ValheimDir>
    <BepInExCore>$(ValheimDir)\BepInEx\core</BepInExCore>
    <GameManaged>$(ValheimDir)\valheim_Data\Managed</GameManaged>
  </PropertyGroup>

  <ItemGroup>
    <!-- Makes game internals public at compile time, so Harmony patches can touch private fields.
         runtime assets are excluded so AsmResolver & co. stay out of bin/. -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild"
                      Version="0.4.3"
                      PrivateAssets="all"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>$(GameManaged)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ValheimDir)\BepInEx\plugins\" />
  </Target>

</Project>
